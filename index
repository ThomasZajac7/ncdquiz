<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>My Google Sites Widget</title>

  <style>
    body{
      font-family:Arial,sans-serif;
      text-align:center;
      padding:20px;
    }

    button{
      padding:10px 20px;
      font-size:18px;
      cursor:pointer;
    }

    #output{
      margin-top:20px;
      font-size:24px;
      color:blue;
    }
  </style>
</head>

<body>

<h2>Embedded GitHub Widget</h2>

<button onclick="sayHello()">
  Click Me
</button>

<div id="output"></div>

<script>
function sayHello(){
  document.getElementById("output").innerHTML =
    "Hello from GitHub Pages!";
}
</script>

</body>
</html>
